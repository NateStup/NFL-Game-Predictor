# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Model artifacts and data
*.joblib
*.pkl
*.pickle
*.h5
# models/* (not models/): git cannot re-include files inside an ignored directory
models/*
data/raw/
data/interim/
data/processed/
*.csv
*.parquet

# Artifacts the deployed service reads at startup; everything else above stays ignored
!data/processed_games.parquet
!models/logistic_regression.joblib
!models/training_config.json

# Notebooks
.ipynb_checkpoints/

# Environment / secrets
.env
.env.*

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
